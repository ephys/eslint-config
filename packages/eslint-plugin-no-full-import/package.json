{
  "name": "@ephys/eslint-plugin-no-full-import",
  "version": "21.0.0",
  "description": "ESLint rule to prevent importing entire packages when a smaller per-member import is preferred",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:eslint && npm run test:prettier && npm run test:unit",
    "test:unit": "node --test dist/__tests__/no-full-import.test.js",
    "test:eslint": "eslint .",
    "test:prettier": "prettier --check .",
    "format": "npm run format:eslint && npm run format:prettier",
    "format:eslint": "eslint . --fix",
    "format:prettier": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ephys/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslintplugin"
  ],
  "author": "Zoé Cox <zoe@ephys.dev>",
  "license": "MIT",
  "homepage": "https://github.com/ephys/eslint-config",
  "peerDependencies": {
    "eslint": "^9.39.4"
  },
  "dependencies": {
    "@sequelize/utils": "^7.0.0-alpha.48",
    "@typescript-eslint/utils": "^8.58.0"
  },
  "devDependencies": {
    "@ephys/eslint-config-typescript": "^21.0.1",
    "@types/node": "^25.5.2",
    "@typescript-eslint/parser": "^8.58.0",
    "@typescript-eslint/rule-tester": "^8.58.0",
    "typescript": "^6.0.2"
  }
}
